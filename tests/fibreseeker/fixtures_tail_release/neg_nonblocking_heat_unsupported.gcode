# OPT: release_mm=6.8
# EXPECT: ERROR FS_NONBLOCKING_HEAT_UNSUPPORTED
# EXPECT: WARN FS_MACRO_CONTRACT_UNVERIFIED
; FS_NONBLOCKING_HEAT_UNSUPPORTED M104 override blocks on this backend
G1 X40.000 Y10.000 U20.000 V40.000 F3000
; Start to cut
M2800
M400
G1 X100.000 Y10.000 V27.400 F3000
; Cutting completed.
G1 F600 V-1.000 ; Retract
; FS_RELEASE_BEGIN length_mm=6.800 speed_mm_s=10.000
G1 X106.800 Y10.000 F600
; FS_RELEASE_END physical_clearance=unmeasured
M1002
M400
G1 F600 V-4.000 ; Toolchange matrix retract
G1 Z0.800 F1200
MOVE_TO_BRUSH_STATION
M400
CLEAN_NOZZLE
M104 S180 T0 ; standby
M104 S250 T1 ; pre-charge
M109 S250 T1
MOVE_OUT_BRUSH_STATION
T1
G90
M83
G1 X20.000 Y10.000 Z0.200 F3000
G1 E10.000 F1500

