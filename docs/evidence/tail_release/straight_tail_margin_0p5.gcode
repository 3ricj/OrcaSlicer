; FibreSeeker3 tail/release comparison export
; variant: straight_tail_margin_0p5
; generated by gen_tail_release_evidence from the shipped Fiber:: planner/emitter
; straight-tail calibration fixture: solid base + 5 strands
; clock: nominal commanded motion; temperature waits and opaque macros contribute zero
; acceleration and heater behaviour are NOT modelled
; physical_tail_clearance: unmeasured
; macro_contract: MACRO_CONTRACT_UNVERIFIED
; print_quality: UNTESTED (static export verification only)
M82
M83
G90
; margin_mm=0.500000
; release_mm=6.800000
M1001 L120
; STRAND 0 cut_x=44.700 post_cut_deposit=55.300
G1 X44.700 Y10.000 U22.350 V44.700 F3000
; Start to cut
M2800
M400
G1 X100.000 Y10.000 V55.300 F3000
; Cutting completed.
G1 F600 V-1.000 ; Retract
; FS_RELEASE_BEGIN length_mm=6.800 speed_mm_s=10.000
G1 X106.800 Y10.000 F600
; FS_RELEASE_END physical_clearance=unmeasured
M1002
M400
G1 F600 V-4.000 ; Toolchange matrix retract
G1 Z0.800 F1200
MOVE_TO_BRUSH_STATION
M400
; FS_STATION_ENTER tool=0
CLEAN_NOZZLE
M104 S180 T0 ; standby
M104 S250 T1 ; pre-charge
; FS_WAIT_BEGIN tool=1 target_c=250 location=brush_station
M109 S250 T1
; FS_WAIT_END tool=1
MOVE_OUT_BRUSH_STATION
; FS_STATION_EXIT
T1 ; switch extruder type to:PLASTIC
G90
M83
G1 X20.000 Y30.000 Z0.200 F3000
G1 E10.000 U0.000 F1500 ; recovery at the next deposition start
