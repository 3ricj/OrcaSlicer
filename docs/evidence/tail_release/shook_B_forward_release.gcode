# OPT: release_mm=6.8
# EXPECT: WARN FS_MACRO_CONTRACT_UNVERIFIED
# EXPECT: WARN FS_TAIL_SHARP_TURN
; FibreSeeker3 tail/release comparison export
; variant: shook_B_forward_release
; generated by gen_tail_release_evidence from the shipped Fiber:: planner/emitter
; DETERMINISTIC STAND-IN EXPORT - not a re-slice of the owner baseline
; clock: nominal commanded motion; temperature waits and opaque macros contribute zero
; acceleration and heater behaviour are NOT modelled
; physical_tail_clearance: unmeasured
; macro_contract: MACRO_CONTRACT_UNVERIFIED
; print_quality: UNTESTED (static export verification only)
M82
M83
G90
; planned_length_mm=182.833 cut_distance_mm=128.033 post_cut_deposit_mm=54.800 post_cut_xy_total_mm=61.600
; seam_distance_mm=53.190 rotation_mm=53.190
; preheat_insert_index=0 nominal_lead_s=3.657 clamped=1
M1001 L120
M104 S250 T1 ; FS_PREHEAT next_tool=1 lead_s=15
G1 X80.000 Y30.000 U3.405 V6.810 F3000
G1 X92.000 Y36.000 U6.708 V13.416 F3000
G1 X92.000 Y48.000 U6.000 V12.000 F3000
G1 X80.000 Y54.000 U6.708 V13.416 F3000
G1 X20.000 Y54.000 U30.000 V60.000 F3000
G1 X20.000 Y31.610 U11.195 V22.390 F3000
; Start to cut
M2800
M400
G1 X20.000 Y30.000 V1.610 F3000
G1 X73.190 Y30.000 V53.190 F3000
; Cutting completed.
G1 F600 V-1.000 ; Retract
; FS_RELEASE_BEGIN length_mm=6.800 speed_mm_s=10.000
G1 X79.990 Y30.000 F600
; FS_RELEASE_END physical_clearance=unmeasured
M1002
M400
G1 F600 V-4.000 ; Toolchange matrix retract
G1 Z0.800 F1200
MOVE_TO_BRUSH_STATION
M400
; FS_STATION_ENTER tool=0
CLEAN_NOZZLE
M104 S180 T0 ; standby
M104 S250 T1 ; pre-charge
; FS_WAIT_BEGIN tool=1 target_c=250 location=brush_station
M109 S250 T1
; FS_WAIT_END tool=1
MOVE_OUT_BRUSH_STATION
; FS_STATION_EXIT
T1 ; switch extruder type to:PLASTIC
G90
M83
G1 X20.000 Y30.000 Z0.200 F3000
G1 E10.000 U0.000 F1500 ; recovery at the next deposition start
